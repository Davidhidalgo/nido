CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_CODEC_ES8311_SUPPORT=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768
CONFIG_FREERTOS_HZ=100
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# ESP32-S3: let the PHY disable USB data while Wi-Fi uses the radio.
# Charging is independent; ROM download remains available after RESET.
CONFIG_ESP_PHY_ENABLE_USB=n
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_NIDO_RECORD_MAX_SECONDS=12
CONFIG_NIDO_RTC_WAKE_TEST_SECONDS=0

CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_TASK_WDT_PANIC=y

CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_2=y
